<%- include("../partials/head.ejs"); %>

  <div class="header">
    <div class="container">
      <div class="header__content">
        <a href="/" class="header__logo">
          LOGO
        </a>
        <div class="header__left">
          <div class="header__profil">
            <div class="header__img">
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
              </svg>
            </div>
            <button type="button" class="btn btn-profil" id="header__profil-click">
              <img src="/img/profil.svg" alt="" srcset="">
            </button>
            <div class="header__profil-top">
              <div class="header__top-pr">
                <div class="header__img">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                  </svg>
                </div>
                <p>
                  iktruoshali@mail.ru
                </p>
              </div>
              <a href="/">Дашборд</a> <br>
              <a href="/auth/logout/">выйти</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
    <main>
      <div class="container">
        <div class="main__content">
          <div class="asside">
            <ul class="asside__lister">
              <div class="content__prever-top">
                <h2>Проекты</h2>
              </div>
              <a href="/admin/" class="asside__item">Добавить проект</a>
              <% if(lister) { %>
                <% for(var i=0; i<lister.length;i++) {%>
                  <a href="/admin/static/<%= lister[i].id %>" class="asside__item">
                    <%=lister[i].title %>
                  </a>
                <%} %>
              <% } %>
            </ul>
            <ul class="asside__lister">
              <h3 class="asside__title">Настройка</h3>
              <a href="/admin/users/" class="asside__item">Добавить пользователя</a>
            </ul>
          </div>
          <div class="content">
            <div class="content__prever">
              <% if(layout=='static' ) { %>
                <%- include("../layouts/static.ejs",{data:data,title:titleStatic}); %>
              <% } %>
              
              <% if(layout=='edit' ) { %>
                  <%- include("../layouts/edit.ejs",{lister:lister}); %>
              <% } %>
              
              <% if(layout=='user' ) { %>
                  <%- include("../layouts/user.ejs",{users:users}); %>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </main>


    <script src="/js/main.js"></script>



    <script>
      
      const localAction = (href) =>{
        const asside__item = document.querySelectorAll('.asside__item')
        for (let i = 0; i < asside__item.length; i++) {
          if(String(asside__item[i].href) == String(href)){
            asside__item[i].classList.add("activ-asside__item")
          }
          
        }
      }
      localAction(window.location.href)
      document.querySelector("#header__profil-click").addEventListener("click", () => {
        const profActiv = document.querySelector(".header__profil-top").classList.toggle("header__profil-active")
      })


    </script>

    </body>
