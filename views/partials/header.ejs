<script>
    const dateResult = (weekNumber) =>{
    const [year, week] = weekNumber.split('-W');
    const startOfWeek = new Date(`${year}-01-01`);
    startOfWeek.setDate(1 + (7 - startOfWeek.getDay() + 1) % 7);
    startOfWeek.setDate(startOfWeek.getDate() + (week - 1) * 7);
    const endOfWeek = new Date(startOfWeek);
    endOfWeek.setDate(startOfWeek.getDate() + 7);
    const formattedStartDate = startOfWeek.toLocaleDateString('ru-RU');
    const formattedEndDate = endOfWeek.toLocaleDateString('ru-RU');
      return {
        formattedStartDate,
        formattedEndDate
      }
  }




  

//  weekInput.showPicker()
function showWeekPicker() {
  const weekInput = document.getElementById("camp-week");
  weekInput.showPicker();
}

function getSelectedWeek() {
  const weekInput = document.getElementById("camp-week");
  return postElement(weekInput.value)

}

document.querySelector("#input-week").addEventListener('click',showWeekPicker)
document.querySelector("#input-week").addEventListener('change',getSelectedWeek)


function postElement(date) {
  const { formattedStartDate,formattedEndDate } = dateResult(date)
    const hrefId = window.location.pathname.split('/')
    const id = hrefId[hrefId.length-1]
    window.location.href = `http://localhost:3000/detail/${id}?startDate=${formattedStartDate}&endDate=${formattedEndDate}`
}
 

</script>
